# Copy to .env and adjust. All values are optional.
ML_MODE=heuristic          # off | heuristic | deberta
INTENT_MODE=heuristic      # off | heuristic | ollama
PII_ENGINE=regex           # regex | presidio
RAG_LLM=extractive         # extractive | ollama
FAIL_MODE=strict           # strict | balanced
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
TOKENIZATION_SECRET=change-me-in-production
GATEWAY_JWT_SECRET=
# JSON map of API key -> identity. Replaces the demo keys.
# GATEWAY_API_KEYS={"my-key":{"user_id":"svc-rag","role":"employee","tenant":"acme"}}
